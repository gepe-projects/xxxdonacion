# --- Aplikasi (prefix APP_) ---
# Wajib diisi: development | staging | production | test.
# Selain development, startup menolak kredensial DB/Redis default.
APP_ENV=development
APP_NAME=app
APP_PORT=8080
# Level minimum log: debug | info | warn | error.
# Kosongkan = otomatis (production => info, lainnya => debug).
APP_LOG_LEVEL=debug
# Format log: json | text. Selain development selalu json.
APP_LOG_FORMAT=text
# CORS allowlist, pisahkan dengan koma. Kosong = CORS nonaktif.
# Wildcard (*) ditolak di luar development.
APP_CORS_ORIGINS=

# --- Database (prefix DB_) — DB_URL wajib ---
DB_URL=postgres://root:root@localhost:5432/xxxdonacion?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m

# --- Redis (prefix REDIS_) ---
# WAJIB hidup saat startup (Ping dilakukan fail-fast di bootstrap).
REDIS_ADDR=localhost:6379
REDIS_USERNAME=root
REDIS_PASSWORD=root
REDIS_DB=0

# ============================================================
# Goose migration (dibaca `goose` & target Makefile up/down/...)
# ============================================================
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://root:root@localhost:5432/xxxdonacion?sslmode=disable
GOOSE_MIGRATION_DIR=./db/postgres/migrations

# Path relatif ke file service account Firebase (jangan di-commit; /secrets sudah di-gitignore).
FIREBASE_CREDENTIALS_FILE=secrets/service-account.json
FIREBASE_PROJECT_ID=


# otel
